@model IEnumerable<AspnetCoreMvcFull.Models.LiveMetric>
@using AspnetCoreMvcFull.Models
@{
    ViewData["Title"] = "Live Dashboard";
    var filter = ViewBag.Filter as DashboardFilterModel ?? new DashboardFilterModel();
}

<div class="card mb-4">
    <div class="card-header"><h5 class="mb-0">Filter dashboard</h5></div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3"><input name="ProjectName" value="@filter.ProjectName" class="form-control" placeholder="Filter theo project" /></div>
            <div class="col-md-2"><input name="FromDate" value="@filter.FromDate?.ToString("yyyy-MM-dd")" type="date" class="form-control" /></div>
            <div class="col-md-2"><input name="ToDate" value="@filter.ToDate?.ToString("yyyy-MM-dd")" type="date" class="form-control" /></div>
            <div class="col-md-2"><input name="PostId" value="@filter.PostId" class="form-control" placeholder="Search post id" /></div>
            <div class="col-md-2">
                <select name="Status" class="form-select">
                    <option value="">All trạng thái</option>
                    <option selected="@(filter.Status=="profit")" value="profit">Profit</option>
                    <option selected="@(filter.Status=="loss")" value="loss">Loss</option>
                </select>
            </div>
            <div class="col-md-1"><button class="btn btn-primary w-100">Lọc</button></div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0">Live Dashboard</h5>
            <small class="text-muted">Theo dõi hiệu suất LIVE theo thời gian thực</small>
        </div>
    </div>

    <div class="table-responsive text-nowrap">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
              <th>Project</th>
              <th>Post ID</th>
              <th>Revenue</th>
              <th>Spend</th>
              <th>Profit</th>
              <th>Status</th>
              <th>Spend</th>
              <th>CPC</th>
              <th>CPM</th>
              <th>Clicks</th>
              <th>Reach</th>
            </tr>
            </thead>
            <tbody class="table-border-bottom-0">
            @foreach(var item in Model)
            {
                var profit = item.EstimatedProfit;
                var isProfit = profit >= 0;
                <tr>
                    <td><strong>@item.ProjectName</strong></td>
                    <td><span class="badge bg-label-secondary">@item.PostId</span></td>
                    <td><span class="fw-semibold text-success">@item.TotalRevenue.ToString("N0")</span></td>
                    <td><span class="fw-semibold text-danger">@item.TotalSpend.ToString("N0")</span></td>
                    <td>
                        @if (isProfit){<span class="badge bg-label-success">+@($"{profit:N0} đ")</span>}else{<span class="badge bg-label-danger">@($"{profit:N0} đ")</span>}
                    </td>
                    <td>@if (isProfit){<span class="badge bg-success">PROFIT</span>}else{<span class="badge bg-danger">LOSS</span>}</td>
                    <td>@item.TotalSpend.ToString("N0")</td>
                    <td>@item.Cpc.ToString("N0")</td>
                    <td>@item.Cpm.ToString("N0")</td>
                    <td>@item.Clicks</td>
                    <td>@item.Reach</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
