@model List<(string Service, string Status)>

<div class="card">
  <div class="card-header">
    <h5>Health Check Dashboard</h5>
  </div>

  <div class="card-body">
    <table class="table table-bordered align-middle">
      <thead>
      <tr>
        <th>Service</th>
        <th>Status</th>
      </tr>
      </thead>

      <tbody>
      @foreach (var item in Model)
      {
        <tr>
          <td>@item.Service</td>
          <td>
            <span class="badge @(item.Status switch
                               {
                                 "OK" or "Running" => "bg-success",
                                 "STALE" => "bg-warning",
                                 _ => "bg-danger"
                               })">
              @item.Status
            </span>
          </td>
        </tr>
      }

      <tr>
        <td>Last Report</td>
        <td>@ViewBag.LastReport</td>
      </tr>

      <tr>
        <td>Worker Last Run</td>
        <td>@ViewBag.LastWorkerRun</td>
      </tr>
      </tbody>
    </table>
  </div>
</div>
