@model IEnumerable<AspnetCoreMvcFull.Models.User>

<div class="card">
  <h5 class="card-header d-flex justify-content-between align-items-center">
    <span>Quản lý người dùng</span>
    <a asp-action="Create" class="btn btn-primary">Thêm người dùng</a>
  </h5>
  <div class="table-responsive text-nowrap">
    @if (TempData["Success"] != null)
    {
      <div class="alert alert-success m-3">@TempData["Success"]</div>
    }
    <table class="table">
      <thead>
      <tr>
        <th>Username</th>
        <th>Họ tên</th>
        <th>Vai trò</th>
        <th>Trạng thái</th>
        <th>Ngày tạo</th>
        <th></th>
      </tr>
      </thead>
      <tbody>
      @foreach (var user in Model)
      {
        <tr>
          <td>@user.Username</td>
          <td>@user.FullName</td>
          <td><span class="badge bg-label-info">@user.RoleName</span></td>
          <td>
            @if (user.IsActive)
            {
              <span class="badge bg-label-success">Active</span>
            }
            else
            {
              <span class="badge bg-label-danger">Locked</span>
            }
          </td>
          <td>@user.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
          <td class="text-end">
            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@user.Id">Sửa</a>
            <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline">
              @Html.AntiForgeryToken()
              <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa user này?')">Xóa</button>
            </form>
          </td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>
